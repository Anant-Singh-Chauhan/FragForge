# ========================================================
# FragForge — Repository .gitignore
# ========================================================

# --- Python & Environments ---
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.egg-info/
dist/
build/

# --- Private Configuration ---
# Keep config.example.json tracked, but ignore active private config
config.json

# --- Personal Branding Assets ---
# Keeps personal logos, glitch SFX, and end-cards private
assets/branding/*
!assets/branding/.gitkeep

# Ensure public app assets (appIcon.ico, etc.) are always tracked
!assets/public/
# assets/public/*

# Generator scripts (if kept local)
scripts/generate_app_logo*.py

# --- Gameplay Footage, Renders & Temp Files ---
raw_clips/**
!raw_clips/
!raw_clips/.gitkeep
!raw_clips/valo/.gitkeep
!raw_clips/cs2/.gitkeep

output/**
!output/
!output/.gitkeep
!output/trimmed/.gitkeep

temp/**
!temp/
!temp/.gitkeep
*.txt.concat

# --- Global Media Catch-All ---
*.mp4
*.mkv
*.mov
*.avi
*.webm

# --- OS & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store