# ========================================================
# FragForge — Repository .gitignore
# ========================================================

# --- Python & Environments ---
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.egg-info/
dist/
build/

# --- Private Configuration ---
# Keep config.example.json tracked, but ignore the active config
config.json

# --- Personal Branding Assets ---
# Keeps personal logo, glitch SFX, and end-cards out of the public repo
assets/branding/*
!assets/branding/.gitkeep
!assets/branding/sample_*
!assets/branding/placeholder_*

# --- Gameplay Footage, Renders & Temp Files ---
# Ignore all staged clips and archived gameplay
raw_clips/**
!raw_clips/
!raw_clips/.gitkeep
!raw_clips/valo/.gitkeep
!raw_clips/cs2/.gitkeep

# Ignore all generated vertical Shorts and trimmed fragments
output/**
!output/
!output/.gitkeep
!output/trimmed/.gitkeep

# Ignore ephemeral scratch workspace & concat files
temp/**
!temp/
!temp/.gitkeep
*.txt.concat

# --- Global Media Catch-All ---
# Failsafe against accidental commits of heavy video/audio
*.mp4
*.mkv
*.mov
*.avi
*.webm

# --- OS & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.DS_Store

# --- app icon generator ---
scripts/generate_app_logo*.py